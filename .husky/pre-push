set -e

plan=$(cat | sh scripts/pre-push-e2e-plan.sh)

case "$plan" in
  none) echo "pre-push: only tests, docs or tooling changed — skipping e2e." ;;
  all) pnpm run test:e2e:push ;;
  *)
    echo "pre-push: running only the affected specs: $plan"
    # shellcheck disable=SC2086
    sh scripts/pre-push-e2e.sh $plan
    ;;
esac
