{
  "name": "hexoflat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level=high",
    "size-limit": "size-limit",
    "prepare": "husky"
  },
  "size-limit": [
    {
      "name": "Main bundle",
      "path": "dist/assets/index-*.js",
      "limit": "110 KB"
    },
    {
      "name": "Hex world map chunk",
      "path": "dist/assets/hex-world-map-*.js",
      "limit": "15 KB"
    },
    {
      "name": "Login chunk",
      "path": "dist/assets/login-page-*.js",
      "limit": "5 KB"
    }
  ],
  "dependencies": {
    "globals": "^16.5.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@pinia/testing": "^1.0.3",
    "@size-limit/file": "^13.0.1",
    "@types/node": "^24.10.0",
    "@types/uuid": "^9.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.2",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.3"
  },
  "lint-staged": {
    "*.{ts,vue}": "eslint --fix",
    "*.{ts,vue,json,md}": "prettier --write"
  }
}
