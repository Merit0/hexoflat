# Matches docker-compose.dev.yml's postgres service (host port 5433, to avoid
# colliding with a locally installed Postgres on the default 5432).
# Copy to .env and adjust if needed.
DATABASE_URL=postgresql://hexoflat:hexoflat@localhost:5433/hexoflat

# apps/web dev server origin, allowed to call this API from the browser.
CORS_ORIGIN=http://localhost:5173

# Dev-only default below (see jwt.env.ts) — set a real secret in any deployed env.
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=7d
