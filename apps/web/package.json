{
  "name": "@hexoflat/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size-limit": "size-limit"
  },
  "size-limit": [
    {
      "name": "Main bundle",
      "path": "dist/assets/index-*.js",
      "limit": "110 KB"
    },
    {
      "name": "Hex world map chunk",
      "path": "dist/assets/hex-world-map-*.js",
      "limit": "100 KB"
    },
    {
      "name": "Login chunk",
      "path": "dist/assets/login-page-*.js",
      "limit": "5 KB"
    }
  ],
  "dependencies": {
    "@hexoflat/engine": "workspace:*",
    "pinia": "^3.0.4",
    "pixi.js": "^8.19.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@size-limit/file": "^13.0.1",
    "@types/node": "^24.10.0",
    "@types/uuid": "^9.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/tsconfig": "^0.8.1",
    "size-limit": "^13.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.1.3"
  }
}
