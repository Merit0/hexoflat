# apps/api base URL. Defaults to http://localhost:3000 if unset.
# Copy to .env and adjust if needed.
VITE_API_URL=http://localhost:3000

# Exploration slice (docs/EXPLORATION-SLICE-WORKFLOW.md). Off unless set to
# 'true'. Ignored in a multiplayer session — the engine forces it off there.
# VITE_FEATURE_EXPLORATION_SLICE=true
