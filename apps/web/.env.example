# apps/api base URL. Defaults to http://localhost:3000 if unset.
# Copy to .env and adjust if needed.
VITE_API_URL=http://localhost:3000

# Login screen feature flags. Unset = on in `vite` dev, off in a production build.
# Hero code / passkey / guardian sign-up need backend work that does not exist yet.
# VITE_AUTH_HERO_CODE=false
# VITE_AUTH_PASSKEY=false
# VITE_AUTH_GUARDIAN_SIGNUP=false
# VITE_AUTH_PLACEHOLDER_LINKS=false
