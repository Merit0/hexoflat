{
  "name": "@hexoflat/playwright",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint \"e2e/**/*.ts\" \"src/**/*.ts\" \"*.ts\"",
    "typecheck": "tsc --noEmit",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.10.0",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "typescript": "~5.9.3"
  }
}
