{
  "name": "@hexoflat/playwright",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "e2e:all": "playwright test",
    "e2e:group": "playwright test --grep",
    "test": "vitest run",
    "e2e:select": "tsx scripts/select-e2e-cli.ts",
    "e2e:map:check": "tsx scripts/e2e-map-check-cli.ts",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint \"e2e/**/*.ts\" \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\"",
    "typecheck": "tsc --noEmit",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.10.0",
    "@types/picomatch": "^4.0.3",
    "@vue/compiler-sfc": "^3.5.43",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "dependency-cruiser": "^18.7.2",
    "picomatch": "^4.0.5",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.6.7"
  }
}
